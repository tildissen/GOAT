# Kopiera till .env.local (lokalt) och lägg in samma värden under
# Settings → Environment Variables i Vercel.
# Hittas i Supabase: Project Settings → API (eller "API Keys").

# Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# "anon public" eller "publishable"-nyckeln
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" eller "secret"-nyckeln. HEMLIG – dela aldrig och använd aldrig i webbläsaren.
SUPABASE_SERVICE_ROLE_KEY=
